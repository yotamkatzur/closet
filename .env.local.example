# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV: copy to .env.local. Every value has a working default — you can run
# the app with an empty .env.local.
#
# PRODUCTION (Railway): set the ones marked [prod] as service variables.
# See README → "Deploying to Railway".
# ─────────────────────────────────────────────────────────────────────────────

# --- Data layer -------------------------------------------------------------
DATA_DRIVER=local
# [prod] Absolute path to the persistent volume. The Docker image defaults this
# to /data; set the Railway volume mount path to match.
# DATA_DIR=/data

# --- Sessions --------------------------------------------------------------
# [prod] REQUIRED. A long random string. Generate: openssl rand -hex 32
# The app refuses to start in production with the dev default.
SESSION_SECRET=

# --- Public URL ----------------------------------------------------------
# [prod] Your live URL, e.g. https://closet.up.railway.app or your domain.
# Appended to outgoing SMS so links work.
PUBLIC_URL=

# --- Admin --------------------------------------------------------------
# [prod] Comma-separated phone numbers that become admins on first sign-in.
# e.g. ADMIN_PHONES=054-1234567
ADMIN_PHONES=

# --- SMS (phone login codes + seller notifications) — Twilio --------------
# Leave blank for local dev: codes print to the server console, SMS is logged.
# [prod] Create a Twilio account + a Verify service, then fill all four.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=          # VA... — handles the login OTP
TWILIO_SMS_FROM=                    # a Twilio number (+1...) for notification SMS
# TWILIO_MESSAGING_SERVICE_SID=     # ...or a Messaging Service SID instead of a From number
NEXT_PUBLIC_SMS_LIVE=               # set to 1 in prod so the UI says "code sent by SMS" not "check the console"

# --- Cron ---------------------------------------------------------------
# [prod] Required if the cron endpoints are hit from outside. Random string.
CRON_SECRET=

# --- Matching -----------------------------------------------------------
MATCH_RANKING_MIN_INVENTORY=300     # keep the feed chronological below this (see analytics spec §6)

# --- AI listing auto-fill --------------------------------------------------
AI_DRIVER=stub                      # "claude" for the real vision call
ANTHROPIC_API_KEY=

# --- Payment & contact (coordinated Bit P2P — no escrow) -----------------
SELLER_FEE_BPS=800                  # 8.00% — recorded on the tx, NOT collected in v1
REQUEST_EXPIRY_HOURS=24
RESERVATION_HOLD_HOURS=48
RETURN_WINDOW_HOURS=48
PAYMENT_MISMATCH_HOURS=72
PREPAY_NUDGE_AGOROT=40000

# --- Analytics ----------------------------------------------------------
STALE_LISTING_DAYS=14
STALE_NO_TAP_DAYS=21
